# ---- Sessions (optional; generated into .data/secret when unset) ----
AUTH_SECRET=

# ---- Influencer data source (optional; without these the app serves sample data) ----
# Apify Instagram scraper — https://apify.com/apify/instagram-scraper
APIFY_TOKEN=
APIFY_ACTOR_ID=apify~instagram-scraper

# Instagram Graph API business discovery (resolves one exact @handle at a time)
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=

# ---- Incoming mail for the Inbox page (also settable in the UI) ----
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=

# Telegram bot that receives replies (also settable in the UI)
TELEGRAM_BOT_TOKEN=

# ---- Email sending (optional; without these outreach is prepared as drafts) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Your Brand <you@example.com>"
