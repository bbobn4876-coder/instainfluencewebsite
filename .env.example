# ---- Storage ----
# With DATABASE_URL the app keeps accounts and settings in Postgres; without it
# they go into files under .data, which only works on a host with a real disk
# (a VPS, Railway with a volume, Render with a persistent disk) — never on
# Netlify or Vercel. Neon, Supabase and Railway all hand you this URL.
DATABASE_URL=
# Set to "off" only for a local database without TLS.
DATABASE_SSL=

# ---- Sessions (optional; generated into .data/secret when unset) ----
AUTH_SECRET=

# ---- Admin account ----
# The address that gets the admin panel. It is created on first run from
# ADMIN_PASSWORD; without that variable no admin account exists.
ADMIN_EMAIL=loomeracompany@gmail.com
ADMIN_PASSWORD=

# ---- Influencer data source (optional; without these the app serves sample data) ----
# HikerAPI — pay per request, no monthly minimum. Preferred when set.
# Verify the token and the endpoints with: npm run check-hiker
HIKER_TOKEN=
# Optional tuning: hashtag pages per search, profiles per round, crawl ceiling.
HIKER_TAG_PAGES=40
HIKER_PROFILE_BATCH=60
HIKER_PROFILE_BUDGET=10000

# Apify Instagram scraper — https://apify.com/apify/instagram-scraper
# Billed per result; used only when HIKER_TOKEN is empty.
APIFY_TOKEN=
APIFY_ACTOR_ID=apify~instagram-scraper
# Result budget for one Apify search; the stages split it between finding
# candidates and reading their profiles. Higher finds more and costs more.
APIFY_RESULT_BUDGET=3000

# Instagram Graph API business discovery (resolves one exact @handle at a time)
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=

# ---- Incoming mail for the Inbox page (also settable in the UI) ----
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=

# Telegram bot that receives replies (also settable in the UI)
TELEGRAM_BOT_TOKEN=

# ---- Email sending (optional; without these outreach is prepared as drafts) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Your Brand <you@example.com>"
