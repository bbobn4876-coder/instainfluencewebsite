# Скопируйте в bot/.env и заполните. Обязателен только токен бота.

# @BotFather → /newbot → токен
LEADS_BOT_TOKEN=

# ---- Источники (все необязательные) ----
# Telegram работает без ключей: добавьте бота в чаты.

# ВКонтакте: сервисный токен приложения (vk.com/apps?act=manage)
VK_SERVICE_TOKEN=

# 2ГИС: ключ Catalog API (dev.2gis.ru)
DGIS_API_KEY=

# Instagram через HikerAPI. Каждый профиль — платный запрос.
HIKER_TOKEN=
LEADS_IG_PROFILES=40

# ---- Сеть ----
# Если антивирус, корпоративный прокси или VPN проверяет HTTPS, Python не
# доверяет его сертификату. Укажите корневой сертификат в .pem:
LEADS_CA_BUNDLE=
# Крайний случай: 1 отключает проверку сертификатов целиком. Тот, кто
# вклинился в соединение, сможет прочитать токен бота. Только для диагностики.
LEADS_INSECURE=

# ---- Необязательное ----
# Кто может командовать ботом: id через запятую. Пусто — может любой.
ALLOWED_USERS=
# Куда класть базу (по умолчанию bot/leads.sqlite3)
LEADS_DB=
